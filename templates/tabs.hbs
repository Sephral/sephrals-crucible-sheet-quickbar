<nav class="fo-tabs tabs" aria-roledescription="{{localize 'SHEETS.FormNavLabel'}}">
    {{#each tabs as |tab|}}
    <a class="fo-tab-link {{tab.cssClass}}" data-action="tab" data-group="{{tab.group}}" data-tab="{{tab.id}}">
        <i class="{{tab.icon}}" inert></i><span>{{localize tab.label}}</span>
        {{#if tab.badge}}<span class="fo-badge{{#if tab.badgeAlert}} alert{{/if}}" inert>{{tab.badge}}</span>{{/if}}
    </a>
    {{/each}}
</nav>
